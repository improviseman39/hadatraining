# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). .env.local is gitignored — never commit
# real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix with NEXT_PUBLIC_, never import from a
# "use client" file. Not used by any code yet — reserved for the Phase 3
# admin invite flow.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
